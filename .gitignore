__pycache__/
.ruff_cache/
.mypy_cache/
.coverage
coverage.json
node_modules/
dist/
build/
*.egg-info/
.DS_Store

# Firmware images belong to whoever wrote them. A copy you already own goes
# here, and nothing in it is ever committed.
firmware/*
!firmware/README.md
*.rom
*.bin

# Cartridges belong to whoever made them. A copy you already own goes here,
# under whatever name it already has, and nothing in it is ever committed.
cartridges/*
!cartridges/README.md
*.sfc
*.smc
